# Required for the standalone pairing API (npm run start:pairing).
PAIRING_API_KEY=replace-with-a-long-random-secret

# Optional: dedicated HTTP port for the standalone pairing API.
PAIRING_PORT=15449

# Render supplies PORT automatically for the main bot + pairing website.
# PORT=10000

# Optional. Protects the legacy /api/main-pair endpoint.
MAIN_PAIR_SECRET=replace-with-a-different-long-random-secret

# Optional comma-separated global owner numbers.
# OWNER_NUMBERS=27621834910
